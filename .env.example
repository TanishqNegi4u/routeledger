# Copy to .env and change every value before exposing this stack to a network.
#   cp .env.example .env

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=routeledger-root
MYSQL_DATABASE=routeledger
MYSQL_USER=routeledger
MYSQL_PASSWORD=routeledger
MYSQL_HOST_PORT=3307

# --- API --------------------------------------------------------------------
# HS256 signing key. Must be 32+ characters. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-routeledger-dev-secret-key-0123456789
JWT_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173
API_HOST_PORT=8081

# --- Demo tenant ------------------------------------------------------------
# Set DEMO_SEED=false for a production deployment - you do not want a sample
# dairy with 45 days of invented invoices sitting in a real customer database.
DEMO_SEED=true
DEMO_PASSWORD=Demo@12345
DEMO_HISTORY_DAYS=45

# --- Web --------------------------------------------------------------------
WEB_HOST_PORT=8080
